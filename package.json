{
  "name": "landtech-bd-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vercel dev",
    "check": "node scripts/check.mjs",
    "test": "node tests/run.mjs",
